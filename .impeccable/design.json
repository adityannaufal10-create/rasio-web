  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Theme-aware primary pill.",
      "html": "<button class=\"ds-primary\">Open workspace →</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:46px;padding:12px 23px;border:0;border-radius:999px;background:var(--action);color:white;font:550 14px var(--font);white-space:nowrap;cursor:pointer;transition:background .2s,transform .15s var(--ease),box-shadow .2s}.ds-primary:hover{background:var(--action-hover);box-shadow:0 4px 12px rgba(0,102,204,.14)}.ds-primary:active{transform:scale(.97)}.ds-primary:disabled{opacity:.5;cursor:not-allowed}.ds-primary:focus-visible{outline:3px solid var(--accent);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-primary:active{transition:none;transform:none}}"
    },
    {
      "name": "Toolbar action",
      "kind": "button",
      "refersTo": "button-toolbar",
      "description": "Compact neutral workspace action.",
      "html": "<button class=\"ds-toolbar\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><span>Search</span></button>",
      "css": ".ds-toolbar{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:36px;padding:8px 11px;border:0;border-radius:9px;background:transparent;color:var(--ink-2);font:400 12px var(--font);white-space:nowrap;cursor:pointer;transition:background .15s}.ds-toolbar:hover{background:var(--muted)}.ds-toolbar:active{transform:scale(.985);transition-duration:.08s}.ds-toolbar:focus-visible{outline:3px solid var(--accent);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-toolbar,.ds-toolbar:active{transition:none;transform:none}}"
    },
    {
      "name": "Circular icon action",
      "kind": "button",
      "description": "Neutral header control.",
      "html": "<button class=\"ds-icon\" aria-label=\"Search\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg></button>",
      "css": ".ds-icon{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border:0;border-radius:50%;background:transparent;color:var(--ink-2);cursor:pointer;transition:background .2s,transform .1s}.ds-icon:hover{background:rgba(29,29,31,.055)}.ds-icon:active{transform:scale(.95)}.ds-icon:focus-visible{outline:3px solid var(--accent);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-icon,.ds-icon:active{transition:none;transform:none}}"
    },
    {
      "name": "Country search",
      "kind": "input",
      "refersTo": "input-country-search",
      "description": "Theme-aware workspace search field.",
      "html": "<label class=\"ds-search\"><span class=\"ds-search-icon\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg></span><input class=\"ds-input\" type=\"search\" aria-label=\"Search economies\" placeholder=\"Search economies…\"></label>",
      "css": ".ds-search{position:relative;display:block;width:100%;max-width:320px}.ds-search-icon{position:absolute;left:12px;top:50%;transform:translateY(-50%);display:flex;pointer-events:none;color:rgb(var(--neutral-600))}.ds-input{width:100%;min-height:40px;padding:6px 12px 6px 36px;border:1px solid rgb(var(--contrast-rgb)/.1);border-radius:12px;background:rgb(var(--neutral-100)/.8);color:rgb(var(--neutral-950));font:400 12px/1.5 var(--font);caret-color:var(--accent)}.ds-input::placeholder{color:rgb(var(--neutral-500))}.ds-input:focus{border-color:rgb(var(--contrast-rgb)/.1);box-shadow:0 0 0 1px rgb(var(--contrast-rgb)/.05)}.ds-input:focus-visible{outline:3px solid var(--accent);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-input,.ds-input:active{transition:none;transform:none}}"
    },
    {
      "name": "Workspace navigation",
      "kind": "nav",
      "description": "Static current-page and idle row samples.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace\"><button class=\"ds-nav-item\" aria-current=\"page\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8 3v3M15 3v11M22 3v18M1 3v18M8 12v9M15 18v3\"/></svg><span><strong>Cartography</strong><small>Maps and system clusters</small></span></button><button class=\"ds-nav-item\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8 3v3M15 3v11M22 3v18M1 3v18M8 12v9M15 18v3\"/></svg><span><strong>Spatial econometrics</strong><small>Regional spillovers</small></span></button></nav>",
      "css": ".ds-nav{padding:12px;background:var(--sidebar);width:228px;display:flex;flex-direction:column;gap:5px}.ds-nav-item{display:flex;align-items:center;gap:10px;width:100%;min-height:50px;padding:11px 12px;text-align:left;border:0;border-radius:11px;background:transparent;color:var(--ink-2);font-family:var(--font);cursor:pointer;transition:background .15s}.ds-nav-item:hover{background:rgb(var(--surface-rgb)/.6)}.ds-nav-item[aria-current=\"page\"]{background:var(--surface);color:var(--accent);box-shadow:0 2px 7px rgba(29,29,31,.045)}.ds-nav-item strong{display:block;font-size:12px;font-weight:600}.ds-nav-item small{display:block;margin-top:3px;font-size:9px;line-height:1.4;color:var(--ink-3)}.ds-nav-item svg{flex-shrink:0}.ds-nav-item:active{transform:scale(.985);transition-duration:.08s}.ds-nav-item:focus-visible{outline:3px solid var(--accent);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-nav-item,.ds-nav-item:active{transition:none;transform:none}}"
    },
