    {
      "name": "Cluster feature card",
      "kind": "card",
      "refersTo": "feature-card",
      "description": "Flat selectable cluster card; schematic content illustrates the existing geometry.",
      "html": "<button class=\"ds-feature\" aria-pressed=\"true\"><span class=\"ds-feature-symbol\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8 3v3M15 3v11M22 3v18M1 3v18M8 12v9M15 18v3\"/></svg></span><span class=\"ds-feature-meta\">Agrifood system typology</span><strong>Agrifood system cluster</strong><span class=\"ds-feature-description\">Explore the existing scientific profile and country composition.</span></button>",
      "css": ".ds-feature{display:flex;flex-direction:column;align-items:flex-start;width:100%;max-width:360px;padding:24px;text-align:left;border:1px solid var(--line);border-radius:12px;background:var(--surface);color:rgb(var(--neutral-950));font-family:var(--font);box-shadow:none;cursor:pointer;transition:background-color .18s,border-color .18s}.ds-feature:hover{border-color:rgb(var(--neutral-300));background:rgb(var(--surface-rgb)/.8)}.ds-feature[aria-pressed=\"true\"]{border-color:var(--accent);background:var(--surface);outline:1px solid var(--accent);outline-offset:-1px}.ds-feature-symbol{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:50%;background:rgb(var(--neutral-100));color:rgb(var(--neutral-800));margin-bottom:16px}.ds-feature-meta{font-size:10px;font-weight:500;color:rgb(var(--neutral-600));line-height:1.5}.ds-feature strong{margin-top:8px;font-size:18px;font-weight:500;letter-spacing:-.025em;line-height:1.25}.ds-feature-description{margin-top:6px;color:rgb(var(--neutral-600));font-size:14px;line-height:1.625}.ds-feature:focus-visible{outline:3px solid var(--accent);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-feature,.ds-feature:active{transition:none;transform:none}}"
    },
    {
      "name": "KPI tile",
      "kind": "card",
      "refersTo": "kpi-card",
      "description": "Neutral metric tile; sample uses the current data-scope value.",
      "html": "<article class=\"ds-kpi\"><div class=\"ds-kpi-heading\"><span class=\"ds-kpi-symbol\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8 3v3M15 3v11M22 3v18M1 3v18M8 12v9M15 18v3\"/></svg></span><h3>Data scope</h3></div><div class=\"ds-kpi-value\"><strong>44</strong><span>Nations</span></div><p>Asia-Pacific 1961–2024</p><span class=\"ds-kpi-badge\">Balanced Panel</span></article>",
      "css": ".ds-kpi{display:flex;flex-direction:column;min-width:0;max-width:280px;padding:24px;border:1px solid var(--line);border-radius:12px;background:var(--surface);box-shadow:none;font-family:var(--font)}.ds-kpi-heading{display:flex;flex-direction:column;align-items:flex-start;gap:16px}.ds-kpi-symbol{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:50%;background:var(--muted);color:var(--ink-2);flex-shrink:0}.ds-kpi h3{margin:0;font-size:13px;font-weight:500;line-height:1.45;letter-spacing:0;color:var(--ink-2)}.ds-kpi-value{display:flex;flex-wrap:wrap;align-items:baseline;gap:7px;margin-top:16px;font-variant-numeric:tabular-nums}.ds-kpi-value strong{font-size:clamp(1.8rem,2.4vw,2.3rem);font-weight:600;line-height:1.1;letter-spacing:-.035em;color:var(--ink)}.ds-kpi-value span{font-size:12px;color:var(--ink-2)}.ds-kpi p{margin:10px 0 0;font-size:12px;line-height:1.6;color:var(--ink-3)}.ds-kpi-badge{align-self:flex-start;margin-top:auto;padding-top:18px;font-size:10px;color:var(--ink-3)}@media(max-width:767px){.ds-kpi{padding:18px}.ds-kpi-heading{gap:12px}.ds-kpi h3{font-size:12px}.ds-kpi-value strong{font-size:28px}}@media(max-width:359px){.ds-kpi-heading{flex-direction:row;align-items:center}}"
    }
  ],
  "narrative": {
    "northStar": "Apple Store clarity, macOS workspace efficiency",
    "overview": "GRAIN pairs a spacious research landing page with a compact analytical workspace for presentation judges. Its confirmed character is clean, elegant, and professional: system typography, graphite and silver surfaces, restrained blue actions, quiet metadata, and readable scientific evidence.\n\nCards are flat, lightly outlined, and purposefully spaced. Medium-weight headings and circular neutral icons keep the interface calm while scientific maps and charts retain meaningful category colors. Light, dark, and system appearances share the same component geometry. Supplied scientific SVGs remain authored evidence; no generated raster imagery forms part of this system.",
    "keyCharacteristics": [
      "Spacious landing composition and efficient workspace density.",
      "Graphite, silver, mist blue, and muted burgundy supporting palette.",
      "Thin borders, restrained corners, medium-weight feature headings.",
      "Theme-aware chrome with preserved scientific color semantics.",
      "Visible defaults, short responses, and reduced-motion adaptations."
    ],
    "rules": [
      {
        "name": "The Scientific Color Rule",
        "body": "Keep cluster, LISA, and heatmap colors attached to their existing scientific categories and thresholds. The supporting chrome palette does not replace these encodings. The five cluster colors in frontmatter preserve the map's industry, livestock, frontier, petro-economy, and population meanings.",
        "section": "colors"
      },
      {
        "name": "The Quiet Card Rule",
        "body": "Use medium-weight feature headings and neutral icon containers; establish hierarchy through size, spacing, and ink roles.",
        "section": "typography"
      },
      {
        "name": "The Flat Card Rule",
        "body": "Do not reintroduce decorative glow or lifted card shadows. Use the current surface, border, and selected outline to communicate card state.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** reuse theme-aware surfaces, ink, and accent roles in both appearances.",
      "**Do** keep feature headings medium, circular icons neutral, and card borders thin.",
      "**Do** use tabular numerals for KPI values and scientific tables.",
      "**Do** preserve scientific SVGs, semantic map colors, controls, and keyboard access.",
      "**Do** preserve local table scrolling and compact narrative phase controls."
    ],
    "donts": [
      "**Don't** add decorative glow or resting shadows to shared cards.",
      "**Don't** recolor scientific categories to match interface chrome.",
      "**Don't** replace responsive controls with a fixed desktop composition.",
      "**Don't** treat screenshot dimensions as a guarantee of physical-device behavior."
    ]
  }
}
